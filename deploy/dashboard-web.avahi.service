<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Advertises the web UI as _homedash._tcp so a client on the LAN (the Apple TV
     app) finds the Pi without a typed address. make web-enable fills in the port. -->
<service-group>
  <name replace-wildcards="yes">Home Dashboard on %h</name>
  <service>
    <type>_homedash._tcp</type>
    <port>__PORT__</port>
    <txt-record>path=/api/dashboard</txt-record>
  </service>
</service-group>
