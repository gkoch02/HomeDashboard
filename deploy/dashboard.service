[Unit]
Description=Home Dashboard eInk renderer
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=oneshot
# These values are filled in automatically by `make pi-enable`.
# __USER__ and __INSTALL_DIR__ are substituted with the current user and repo path.
User=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=GPIOZERO_PIN_FACTORY=lgpio
# Consume the web UI's trigger file *before* the run. ExecStartPost only runs
# after a successful ExecStart, so a crashing run used to leave the file in
# place; dashboard-trigger.path (PathExists=) then restarted the service the
# moment it stopped, until StartLimitBurst locked the unit — and with it the
# timer and every later "Refresh Now" (#261). The "-" prefix means a missing
# file (the normal timer-driven case) is not an error.
ExecStartPre=-/bin/rm -f __INSTALL_DIR__/state/web_trigger
# A Pi has no RTC: until NTP syncs, the clock reads the last shutdown time, and
# a run then judges quiet hours, the morning-refresh marker and cache ages
# against the wrong time and persists wrong timestamps into state/ (#301).
# Wait for the sync, but only briefly: systemd-time-wait-sync returns at once
# when the clock is already synced, and the timeout means an offline boot
# still renders from cache instead of never running. Deliberately not
# After=time-sync.target with systemd-time-wait-sync.service enabled — that
# wait is unbounded, and OnCalendar= timers order themselves after
# time-sync.target implicitly, so an offline Pi would never fire the timer at
# all. The "-" prefix ignores a timeout or a system without the helper.
ExecStartPre=-/usr/bin/timeout 45 /lib/systemd/systemd-time-wait-sync
ExecStart=__INSTALL_DIR__/venv/bin/python -m src.main --config config/config.yaml
# No Restart=: the timer runs again in five minutes and the path unit re-fires
# on the next trigger, so an immediate retry only burned the start limit.
StandardOutput=append:__INSTALL_DIR__/output/dashboard.log
StandardError=append:__INSTALL_DIR__/output/dashboard.log
